# Your Discord user token (Settings > Advanced > copy from network requests)
DISCORD_TOKEN=

# Password for the gallery website
SITE_PASSWORD=

# Random string used to sign session cookies — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port for the web server (Railway sets this automatically)
PORT=3000

# Override media storage directory (Railway: mount a volume at /data)
# MEDIA_DIR=/data/media

# Who to DM when something is received: a user ID, or the username / display name / nickname of a friend. Leave blank to disable.
NOTIFY_USER_ID=

# Notification templates. Placeholders: {sender}, {senderId}, {content}, {count}, {files}. Use \n for a newline.
# Set either to an empty value (e.g. NOTIFY_TEXT_MESSAGE=) to turn that notification off.
NOTIFY_MEDIA_MESSAGE="New media from {sender}: {count} file(s) — {files}"
NOTIFY_TEXT_MESSAGE="Message from {sender}: {content}"

# Your Discord user token (Settings > Advanced > copy from network requests)
DISCORD_TOKEN=

# Password for the gallery website
SITE_PASSWORD=

# Random string used to sign session cookies — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port for the web server (Railway sets this automatically)
PORT=3000

# Override media storage directory (Railway: mount a volume at /data)
# MEDIA_DIR=/data/media
